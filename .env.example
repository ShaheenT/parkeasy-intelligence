NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Dedicated ParkEasy Intelligence database. Do not point this at ParkEasy production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parkeasy_intelligence
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Generate with: npm run keys:generate
# Multiple keys separated by commas. Never commit real keys.
PEI_API_KEYS=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
INVENTORY_FRESHNESS_MINUTES=15
